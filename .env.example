# Copy to .env and fill in. .env is git-ignored — never commit real values.

# Sepolia JSON-RPC endpoint (Alchemy, Infura, or any provider).
SEPOLIA_RPC_URL=

# Etherscan API key, used by `--verify` to publish source code.
ETHERSCAN_API_KEY=

# Optional: extra addresses to whitelist at deploy time (comma-separated).
# WHITELIST=0xabc...,0xdef...

# Optional: annual yield rate in basis points (default 500 = 5.00%, max 2000).
# YIELD_BPS=500

# The deployer key is NOT stored here. Import it into Foundry's encrypted keystore instead:
#   cast wallet import deployer --interactive
