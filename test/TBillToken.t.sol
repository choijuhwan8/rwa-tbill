pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {TBillToken} from "../src/TBillToken.sol";
import {Whitelist} from "../src/Whitelist.sol";
import {IAccessControl} from "@openzeppelin/contracts/access/IAccessControl.sol";

contract TBillTokenTest is Test {
    TBillToken public token;
    Whitelist public whitelist;

    // Test actors — labeled addresses generated by makeAddr.
    address admin = address(this); // this test contract deploys both contracts → holds admin roles
    address vault = makeAddr("vault"); // will be granted VAULT_ROLE
    address alice = makeAddr("alice"); // a user we WILL whitelist
    address bob = makeAddr("bob"); // another user we WILL whitelist
    address charlie = makeAddr("charlie"); // a user we DO NOT whitelist

    function setUp() public {
        // 1. Deploy the whitelist. This test contract holds COMPLIANCE_ROLE.
        whitelist = new Whitelist();

        // 2. Deploy the token, pointing it at the whitelist. This contract holds DEFAULT_ADMIN_ROLE.
        token = new TBillToken(address(whitelist));

        // 3. Grant the vault address VAULT_ROLE so it can mint/burn.
        token.grantRole(token.VAULT_ROLE(), vault);

        // 4. Whitelist alice and bob (but NOT charlie).
        whitelist.addToWhitelist(alice);
        whitelist.addToWhitelist(bob);
    }

    // Small helper: mint `amount` to `who` as the vault.
    function _mintTo(address who, uint256 amount) internal {
        vm.prank(vault);
        token.mint(who, amount);
    }

    // ---------------------------------------------------------------------
    // Access control (carried over from Phase 1, still valid)
    // ---------------------------------------------------------------------

    // 1. The deployer holds DEFAULT_ADMIN_ROLE.
    function test_DeployerIsAdmin() public view {
        assertTrue(token.hasRole(token.DEFAULT_ADMIN_ROLE(), admin));
    }

    // 2. A caller WITHOUT VAULT_ROLE cannot mint — reverts on the role check.
    function test_MintRevertsForNonVault() public {
        vm.expectRevert(
            abi.encodeWithSelector(
                IAccessControl.AccessControlUnauthorizedAccount.selector, charlie, token.VAULT_ROLE()
            )
        );
        vm.prank(charlie);
        token.mint(alice, 1e18);
    }

    // 3. The vault CAN mint to a whitelisted address.
    function test_VaultCanMintToWhitelisted() public {
        _mintTo(alice, 100e18);
        assertEq(token.balanceOf(alice), 100e18);
        assertEq(token.totalSupply(), 100e18);
    }

    // ---------------------------------------------------------------------
    // Compliance / whitelist behavior (the Phase 2 heart)
    // ---------------------------------------------------------------------

    // 4. Minting to a NON-whitelisted address reverts (mint still runs the `to` check).
    function test_MintToNonWhitelistedReverts() public {
        vm.expectRevert(abi.encodeWithSelector(TBillToken.NotWhitelisted.selector, charlie));
        _mintTo(charlie, 100e18);
    }

    // 5. Whitelisted -> whitelisted transfer succeeds.
    function test_TransferBetweenWhitelistedSucceeds() public {
        _mintTo(alice, 100e18);

        vm.prank(alice);
        assertTrue(token.transfer(bob, 40e18));

        assertEq(token.balanceOf(bob), 40e18);
        assertEq(token.balanceOf(alice), 60e18);
    }

    // 6. Transfer TO a non-whitelisted address reverts with NotWhitelisted(recipient).
    function test_TransferToNonWhitelistedReverts() public {
        _mintTo(alice, 100e18);

        vm.expectRevert(abi.encodeWithSelector(TBillToken.NotWhitelisted.selector, charlie));
        vm.prank(alice);
        token.transfer(charlie, 10e18);
    }

    // 7. Transfer FROM a de-whitelisted address reverts with NotWhitelisted(sender).
    //    Also proves removal doesn't touch existing balance — only future movement.
    function test_RemovedFromWhitelistCannotSend() public {
        _mintTo(alice, 100e18);

        // Compliance removes alice.
        whitelist.removeFromWhitelist(alice);

        // Her balance is untouched...
        assertEq(token.balanceOf(alice), 100e18);

        // ...but she can no longer send.
        vm.expectRevert(abi.encodeWithSelector(TBillToken.NotWhitelisted.selector, alice));
        vm.prank(alice);
        token.transfer(bob, 10e18);
    }

    // 8. A de-whitelisted address also cannot RECEIVE.
    function test_RemovedFromWhitelistCannotReceive() public {
        _mintTo(alice, 100e18);
        whitelist.removeFromWhitelist(bob);

        vm.expectRevert(abi.encodeWithSelector(TBillToken.NotWhitelisted.selector, bob));
        vm.prank(alice);
        token.transfer(bob, 10e18);
    }

    // 9. Burn works for a whitelisted holder (burn skips the `to == address(0)` check).
    function test_BurnWhitelistedHolder() public {
        _mintTo(alice, 100e18);

        vm.prank(vault);
        token.burn(alice, 50e18);

        assertEq(token.balanceOf(alice), 50e18);
        assertEq(token.totalSupply(), 50e18);
    }

    // 10. Burn is gated to VAULT_ROLE (a non-vault cannot burn).
    function test_BurnGatedToVault() public {
        _mintTo(alice, 100e18);

        vm.expectRevert(
            abi.encodeWithSelector(IAccessControl.AccessControlUnauthorizedAccount.selector, alice, token.VAULT_ROLE())
        );
        vm.prank(alice);
        token.burn(alice, 50e18);
    }

    // 11. Sanity: still 18 decimals.
    function test_DecimalsIsEighteen() public view {
        assertEq(token.decimals(), 18);
    }
}
