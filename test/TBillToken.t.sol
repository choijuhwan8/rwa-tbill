pragma solidity ^0.8.24;

import {Test} from "forge-std/Test.sol";
import {TBillToken} from "../src/TBillToken.sol";
import {IAccessControl} from "@openzeppelin/contracts/access/IAccessControl.sol";

contract TBillTokenTest is Test {
    TBillToken public token;

    // Test actors — labeled addresses generated by makeAddr.
    address admin = address(this); // the deployer of `token` in setUp() is this test contract
    address vault = makeAddr("vault"); // will be granted VAULT_ROLE
    address alice = makeAddr("alice"); // a random user, no roles
    address bob = makeAddr("bob"); // another random user

    function setUp() public {
        // This test contract deploys the token, so it holds DEFAULT_ADMIN_ROLE.
        token = new TBillToken();
    }

    // 1. The deployer holds DEFAULT_ADMIN_ROLE.
    function test_DeployerIsAdmin() public view {
        assertTrue(token.hasRole(token.DEFAULT_ADMIN_ROLE(), admin));
    }

    // 2. Nobody has VAULT_ROLE at deploy time (not even the admin) —
    //    proves we did NOT grant it in the constructor.
    function test_NoOneHasVaultRoleInitially() public view {
        assertFalse(token.hasRole(token.VAULT_ROLE(), admin));
        assertFalse(token.hasRole(token.VAULT_ROLE(), vault));
    }

    // 3. A caller WITHOUT VAULT_ROLE cannot mint — the call must revert.
    function test_MintRevertsForNonVault() public {
        // Tell Foundry: the next call is expected to revert with this exact error.
        vm.expectRevert(
            abi.encodeWithSelector(IAccessControl.AccessControlUnauthorizedAccount.selector, alice, token.VAULT_ROLE())
        );
        // Impersonate alice for the next call, then attempt to mint.
        vm.prank(alice);
        token.mint(alice, 1e18);
    }

    // 4. After the admin grants VAULT_ROLE, that address CAN mint.
    function test_VaultCanMintAfterGrant() public {
        // admin (this contract) grants VAULT_ROLE to `vault`.
        token.grantRole(token.VAULT_ROLE(), vault);

        // Now act as the vault and mint to alice.
        vm.prank(vault);
        token.mint(alice, 100e18);

        assertEq(token.balanceOf(alice), 100e18);
        assertEq(token.totalSupply(), 100e18);
    }

    // 5. burn is likewise gated to VAULT_ROLE.
    function test_BurnGatedToVault() public {
        token.grantRole(token.VAULT_ROLE(), vault);

        // Mint some to alice first (as the vault).
        vm.prank(vault);
        token.mint(alice, 100e18);

        // A non-vault (alice) trying to burn must revert.
        vm.expectRevert(
            abi.encodeWithSelector(IAccessControl.AccessControlUnauthorizedAccount.selector, alice, token.VAULT_ROLE())
        );
        vm.prank(alice);
        token.burn(alice, 50e18);

        // The vault CAN burn.
        vm.prank(vault);
        token.burn(alice, 50e18);
        assertEq(token.balanceOf(alice), 50e18);
    }

    // 6. Ordinary transfers between holders work (inherited ERC-20 logic).
    function test_TransferWorks() public {
        token.grantRole(token.VAULT_ROLE(), vault);
        vm.prank(vault);
        token.mint(alice, 100e18);

        // alice transfers to bob.
        vm.prank(alice);
        assertTrue(token.transfer(bob, 40e18));

        assertEq(token.balanceOf(bob), 40e18);
        assertEq(token.balanceOf(alice), 60e18);
    }

    // 7. Uses default 18 decimals (we removed the override).
    function test_DecimalsIsEighteen() public view {
        assertEq(token.decimals(), 18);
    }
}
